# Copie este arquivo para .env.local e preencha os valores reais.
# NUNCA commite o .env.local — ele fica de fora do git pelo .gitignore.

# Sua chave da Muapi — fica só no servidor, o navegador do usuário nunca a vê.
MUAPI_API_KEY=

# Chave secreta para assinar os cookies de sessão. Gere uma aleatória, ex:
# openssl rand -base64 32
JWT_SECRET=

# Stripe — pegue em dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=
# Gerado ao criar o webhook endpoint em dashboard.stripe.com/webhooks
STRIPE_WEBHOOK_SECRET=

# Qual provedor cobra NOVAS assinaturas e compras: "stripe" (padrão) ou
# "pagarme". Quem já assina por um provedor continua nele até migrar.
BILLING_PROVIDER=stripe

# Pagar.me — painel da Pagar.me > Configurações > Chaves.
# Também vale a chave criada no portal Stone (Nova integração > Pagamentos).
# sk_test_... = teste; sk_... = produção. Nunca commite o valor real.
PAGARME_SECRET_KEY=
# Senha que vai na URL do webhook (?token=...). Invente uma longa e aleatória.
PAGARME_WEBHOOK_TOKEN=
# E-mails (separados por vírgula) que pagam pela Pagar.me mesmo com
# BILLING_PROVIDER=stripe — para testar sem afetar os clientes.
PAGARME_TEST_EMAILS=

# Cotação USD->BRL usada para converter o custo da Muapi (em US$) para R$.
# Atualize periodicamente, ou troque por uma chamada a uma API de câmbio.
USD_TO_BRL=5.30

# Múltiplo sobre o custo real da Muapi que você cobra do usuário.
# 4 = você cobra 4x o que a Muapi te cobra.
PRICE_MARKUP=4

# Créditos grátis (em R$) dados a quem cria conta — 0 para desativar.
SIGNUP_FREE_CREDITS=5

# URL pública do site (usada nos redirects do Stripe Checkout)
APP_URL=http://localhost:3000

# Caminho do arquivo SQLite (opcional — padrão: ./data/app.db)
DB_PATH=
